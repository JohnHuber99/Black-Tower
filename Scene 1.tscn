[sub_resource type="GDScript" id="GDScript_gxldu"]
script/source = "extends CharacterBody2D

@export var speed = 64
@onready var _animated_sprite = $AnimatedSprite2D
var walk_direction = \"walk_left\"

func get_input():
	var input_direction = Input.get_vector(\"left\",\"right\",\"up\",\"down\")
	velocity = input_direction * speed

func _physics_process(delta):
	get_input()
	move_and_slide()
	
func _process(_delta):
	if !velocity.is_zero_approx():
		if (velocity.x > 0):
			walk_direction = \"walk_right\"
		if (velocity.x < 0):
			walk_direction = \"walk_left\"
		_animated_sprite.play(walk_direction)
	else:
		if (walk_direction == \"walk_right\"):
			_animated_sprite.play(\"idle_right\")
		if (walk_direction == \"walk_left\"):
			_animated_sprite.play(\"idle_left\")
"

